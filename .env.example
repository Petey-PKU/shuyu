# Copy this file to .env.local only when local configuration is required.
# Never place translation-provider secrets in EXPO_PUBLIC_* variables: those
# values are embedded in the mobile app and can be read by users.

# Optional public URL of a Shuyu-compatible translation proxy. When configured,
# it runs before the built-in Bing-compatible path and MyMemory fallback. The
# proxy must accept POST { text, source, target } and return { translation }.
# Keep provider credentials on that server; only its URL belongs in the bundle.
EXPO_PUBLIC_TRANSLATION_ENDPOINT=
# User-facing label shown in Settings. Recommended for the bundled gateway:
# Azure Translator → 腾讯云 TMT
EXPO_PUBLIC_TRANSLATION_PROVIDER_NAME=
