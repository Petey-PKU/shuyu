{
  "expo": {
    "name": "书语",
    "slug": "shuyu",
    "description": "在书里，学会一门语言。本地优先的英语语境阅读器。",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/shuyu-icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F1EA",
    "primaryColor": "#FF7043",
    "scheme": "shuyu",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.shuyu.reader",
      "buildNumber": "3"
    },
    "android": {
      "package": "app.shuyu.reader",
      "versionCode": 3,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA",
        "foregroundImage": "./assets/shuyu-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/shuyu-icon.png"
    },
    "plugins": [
      "expo-document-picker",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EA",
          "image": "./assets/shuyu-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
