{
  "expo": {
    "name": "书中语",
    "slug": "shuzhongyu",
    "description": "在书里，学会一门语言。本地优先的外语原著学习阅读器。",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/shuzhongyu-icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F1EA",
    "primaryColor": "#FF7043",
    "scheme": "shuzhongyu",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.shuzhongyu.reader",
      "buildNumber": "2"
    },
    "android": {
      "package": "app.shuzhongyu.reader",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA",
        "foregroundImage": "./assets/shuzhongyu-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/shuzhongyu-icon.png"
    },
    "plugins": [
      "expo-document-picker",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EA",
          "image": "./assets/shuzhongyu-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
