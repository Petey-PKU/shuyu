# Provider order. A provider without complete credentials is skipped.
TRANSLATION_PROVIDER_ORDER=azure,tencent

# Azure Translator global cloud:
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# Azure operated by 21Vianet in China instead uses:
# AZURE_TRANSLATOR_ENDPOINT=https://api.translator.azure.cn
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Tencent Cloud Machine Translation fallback.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
# Only set this when using temporary Tencent credentials.
TENCENT_SESSION_TOKEN=

# Safety controls.
MAX_TEXT_CHARACTERS=4000
MAX_REQUESTS_PER_MINUTE=60
CACHE_TTL_SECONDS=86400
MAX_CACHE_ENTRIES=1000
PROVIDER_TIMEOUT_MS=7000
SHUYU_ALLOWED_ORIGIN=*
